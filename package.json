{
  "name": "ai-playground",
  "version": "0.1.1",
  "private": true,
  "description": "AI 游乐场 —— 人类与 AI Agent 同桌玩的小游戏大厅",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ai-playground": "./packages/cli/src/index.ts"
  },
  "scripts": {
    "cli": "tsx packages/cli/src/index.ts",
    "dev": "node scripts/sync-audio.mjs && concurrently -k -n server,web -c cyan,magenta \"pnpm -C packages/server dev\" \"pnpm -C packages/web dev\"",
    "dev:server": "pnpm -C packages/server dev",
    "dev:web": "pnpm -C packages/web dev",
    "serve": "pnpm -C packages/server start",
    "mcp": "pnpm -C packages/mcp exec tsx src/cli.ts",
    "test": "pnpm -C packages/core test",
    "test:all": "pnpm -C packages/core test && pnpm -C packages/server test",
    "e2e": "tsx scripts/e2e.ts",
    "replay": "tsx scripts/replay.ts",
    "check:contrast": "node scripts/check-contrast.mjs",
    "audio:sync": "node scripts/sync-audio.mjs",
    "prebuild": "node scripts/sync-audio.mjs",
    "build": "pnpm -C packages/web build",
    "start": "pnpm build && pnpm serve"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}

